{
    "output_mode": {
        "description": "搜索结果输出方式",
        "type": "string",
        "options": [
            "card",
            "text"
        ],
        "hint": "card：渲染为结果卡片图片（默认，带缩略图/相似度徽章）；text：纯文本输出，按结果逐条发送（每条附带该结果的图片），不使用卡片设计",
        "default": "card"
    },
    "text_merge": {
        "description": "文本模式合并为聊天记录",
        "type": "bool",
        "hint": "开启后 text 模式会把「汇总 + 每条结果」合并成一条合并转发（聊天记录）。仅 QQ（aiocqhttp/OneBot）等支持合并转发的平台生效，其他平台或关闭时逐条发送",
        "default": true
    },
    "result_image_size": {
        "description": "结果配图分辨率",
        "type": "string",
        "options": [
            "low",
            "standard",
            "original"
        ],
        "hint": "text 模式每条结果附带图片的分辨率：low 超低清（直接用引擎缩略图，最省流量）/ standard 标清（原始大图缩放到最长边 640，默认）/ original 原图（原始大图不缩放，仅对超大图做兜底缩放）",
        "default": "standard"
    },
    "enable_keyword_trigger": {
        "description": "启用关键词触发搜索",
        "type": "bool",
        "hint": "关闭后用户仍可通过 LLM 工具搜图，但不再响应「以图搜图」等关键词",
        "default": true
    },
    "proxies": {
        "description": "代理服务器地址",
        "type": "string",
        "hint": "http://host:port，例如：http://127.0.0.1:7890",
        "default": ""
    },
    "aiornot": {
        "description": "AI 生成检测（AI or Not）",
        "type": "object",
        "hint": "启用后每次识图都会先调用 aiornot.com 检测图片是否为 AI 生成，结果与搜索结果一起展示；同时解锁「AI 检测」引擎（只检测、不反搜）",
        "items": {
            "enabled": {
                "description": "启用 AI 生成检测",
                "type": "bool",
                "hint": "开启后每次识图前会先做一次 AI 检测（会多一次网络请求，并按 AI or Not 的接口计费）",
                "default": false
            },
            "api_key": {
                "description": "AI or Not API Key",
                "type": "string",
                "hint": "从 https://www.aiornot.com/dashboard/api 获取；留空则不会调用 AI 检测",
                "default": ""
            },
            "timeout": {
                "description": "AI 检测超时（秒）",
                "type": "int",
                "hint": "超过该时间未返回则跳过 AI 检测，继续正常搜图",
                "default": 20
            }
        }
    },
    "illuminarty": {
        "description": "AI 生成检测备用（Illuminarty）",
        "type": "object",
        "hint": "免费、无需 API Key：调用 app.illuminarty.ai 主页使用的识别接口。AI or Not 额度用完/报错时会自动切换；未配置 AI or Not 时也可单独使用。注意这是该网站未公开的网页接口，可能变更或限流",
        "items": {
            "enabled": {
                "description": "启用 Illuminarty 备用检测",
                "type": "bool",
                "hint": "图片会先发给 AI or Not（若已配置），失败后再发给 Illuminarty；两者都失败则不带 AI 结果",
                "default": false
            },
            "timeout": {
                "description": "Illuminarty 检测超时（秒）",
                "type": "int",
                "hint": "该接口偶尔较慢，建议 40~90 秒",
                "default": 60
            }
        }
    },
    "ai_detect_mode": {
        "description": "AI 检测方式",
        "type": "string",
        "options": [
            "fallback",
            "both"
        ],
        "hint": "fallback：优先 AI or Not，失败（额度用完/报错/超时）才用 Illuminarty；both：两个通道同时检测，结果分别展示（两者判断可能相反，可对比参考）。两个通道的开关在各自的配置块里",
        "default": "fallback"
    },
    "allow_third_party_image_host": {
        "description": "允许上传到第三方图床",
        "type": "bool",
        "hint": "Google/Yandex 本地图搜需先把图片上传到临时图床（tmpfiles/uguu/litterbox 等）。关闭后这两引擎不可用本地图搜，需改用图片 URL",
        "default": true
    },
    "timeout_settings": {
        "description": "超时配置",
        "type": "object",
        "items": {
            "search_params_timeout": {
                "description": "等待搜索参数（引擎名、图片等）的时间（秒）",
                "type": "int",
                "hint": "用户在发送'以图搜图'命令后，等待提供引擎名称和图片的最大时间",
                "default": 30
            }
        }
    },
    "keyword": {
        "description": "关键词",
        "type": "object",
        "hint": "配置触发搜索的关键词和各搜索引擎的自定义关键词",
        "items": {
            "trigger_keywords": {
                "description": "触发搜索的关键词列表",
                "type": "list",
                "hint": "用户发送任意一个关键词时触发图片搜索功能，留空则使用默认关键词",
                "default": [
                    "以图搜图",
                    "image search"
                ]
            },
            "engine_keywords": {
                "description": "各搜索引擎的自定义关键词（别名）",
                "type": "object",
                "hint": "为每个搜索引擎配置自定义关键词，用户可以使用这些关键词指定引擎，留空则使用默认引擎名",
                "items": {
                    "animetrace": {
                        "description": "AnimeTrace",
                        "type": "string",
                        "default": "a"
                    },
                    "ehentai": {
                        "description": "E-Hentai",
                        "type": "string",
                        "default": "e"
                    },
                    "google": {
                        "description": "Google",
                        "type": "string",
                        "default": "g"
                    },
                    "yandex": {
                        "description": "Yandex",
                        "type": "string",
                        "default": "y"
                    },
                    "saucenao": {
                        "description": "SauceNAO",
                        "type": "string",
                        "default": "s"
                    },
                    "ai": {
                        "description": "AI 检测",
                        "type": "string",
                        "hint": "只检测图片是否为 AI 生成，不做反向搜索（需先启用 AI or Not）",
                        "default": "ai"
                    }
                }
            }
        }
    },
    "available_apis": {
        "description": "启用状态",
        "type": "object",
        "items": {
            "animetrace": {
                "description": "AnimeTrace",
                "type": "bool",
                "default": true
            },
            "ehentai": {
                "description": "E-Hentai/ExHentai",
                "type": "bool",
                "default": true
            },
            "google": {
                "description": "Google Lens",
                "type": "bool",
                "default": true
            },
            "yandex": {
                "description": "Yandex",
                "type": "bool",
                "default": true
            },
            "saucenao": {
                "description": "SauceNAO",
                "type": "bool",
                "default": true
            },
            "ai": {
                "description": "AI 检测（需配置 AI or Not API Key）",
                "type": "bool",
                "hint": "只检测图片是否为 AI 生成，不做反向搜索；未填写 API Key 时该引擎不会出现",
                "default": true
            }
        }
    },
    "default_params": {
        "description": "默认参数",
        "type": "object",
        "items": {
            "animetrace": {
                "description": "AnimeTrace",
                "type": "object",
                "items": {
                    "model": {
                        "description": "识别模型（默认：full_game_model_kira）",
                        "type": "string",
                        "hint": "可选模型: anime_model_lovelive, pre_stable, anime, full_game_model_kira",
                        "default": "full_game_model_kira"
                    },
                    "is_multi": {
                        "description": "多角色搜索模式",
                        "type": "bool",
                        "hint": "检测图片中的多个角色",
                        "default": false
                    },
                    "ai_detect": {
                        "description": "AI检测模式",
                        "type": "bool",
                        "hint": "检测图片是否为AI生成",
                        "default": false
                    }
                }
            },
            "ehentai": {
                "description": "EHentai",
                "type": "object",
                "items": {
                    "is_ex": {
                        "description": "是否使用ExHentai而不是E-Hentai",
                        "type": "bool",
                        "hint": "需要ExHentai账号和有效Cookie",
                        "default": false
                    },
                    "covers": {
                        "description": "是否包含封面搜索结果",
                        "type": "bool",
                        "default": false
                    },
                    "similar": {
                        "description": "是否包含相似结果",
                        "type": "bool",
                        "default": true
                    },
                    "exp": {
                        "description": "是否启用实验性搜索模式",
                        "type": "bool",
                        "default": false
                    },
                    "cookies": {
                        "description": "E-Hentai Cookie",
                        "type": "string",
                        "default": "",
                        "hint": "获取：登录 e-hentai.org（ExHentai 需 exhentai.org）后 F12 → Console 标签 → 输入 document.cookie 回车 → 复制输出的整行（含 ipb_member_id/ipb_pass_hash/igneous）。仅搜 E-Hentai 可留空，搜 ExHentai 必需"
                    }
                }
            },
            "google": {
                "description": "Google API",
                "type": "object",
                "items": {
                    "serpapi_key": {
                        "description": "SerpApi API Key",
                        "type": "string",
                        "hint": "可选 (推荐). 从 https://serpapi.com/ 申请. 使用Google Lens实现。",
                        "default": null
                    },
                    "zenserp_key": {
                        "description": "Zenserp API Key",
                        "type": "string",
                        "hint": "可选 (备用). 从 https://zenserp.com/ 申请. 使用Google Reverse Image实现。",
                        "default": null
                    },
                    "hl": {
                        "description": "语言 (Language)",
                        "type": "string",
                        "hint": "Google界面语言代码 (如: zh-CN, en, ja)",
                        "default": "zh-CN"
                    },
                    "country": {
                        "description": "国家/地区 (Country)",
                        "type": "string",
                        "hint": "搜索结果针对的国家/地区代码 (如: cn, us, jp)",
                        "default": "HK"
                    },
                    "max_results": {
                        "description": "最大结果数",
                        "type": "int",
                        "hint": "API返回的最大结果数量 (注意: SerpApi/Zenserp分页可能耗费额度)",
                        "default": 10
                    }
                }
            },
            "saucenao": {
                "description": "SauceNAO",
                "type": "object",
                "items": {
                    "api_key": {
                        "description": "SauceNAO API密钥",
                        "type": "string",
                        "hint": "用于访问SauceNAO API，免费账户每日限制150次，每30秒4次",
                        "default": null
                    },
                    "hide": {
                        "description": "隐藏级别",
                        "type": "int",
                        "default": 3
                    },
                    "numres": {
                        "description": "返回结果数量",
                        "type": "int",
                        "default": 5
                    },
                    "minsim": {
                        "description": "最低相似度",
                        "type": "int",
                        "default": 30
                    },
                    "output_type": {
                        "description": "输出类型(2表示JSON输出)",
                        "type": "int",
                        "default": 2
                    }
                }
            },
            "yandex": {
                "description": "Yandex",
                "type": "object",
                "items": {
                    "max_results": {
                        "description": "最大结果数",
                        "type": "int",
                        "default": 10
                    },
                    "use_ru_fallback": {
                        "description": "启用 .ru 域名回退",
                        "type": "bool",
                        "hint": "当 .com 访问失败时尝试使用 yandex.ru",
                        "default": true
                    },
                    "cookies": {
                        "description": "Yandex Cookie",
                        "type": "string",
                        "default": "",
                        "hint": "获取：登录 yandex.com/images 后 F12 → Console 标签 → 输入 document.cookie 回车复制（拿不到 HttpOnly 字段时改用：F12 → Network 标签（过滤框保持空白！）→ 刷新 → 点第一条请求 → Headers → 请求头 Cookie 行整行复制）。留空可能触发验证码导致无结果"
                    }
                }
            }
        }
    }
}